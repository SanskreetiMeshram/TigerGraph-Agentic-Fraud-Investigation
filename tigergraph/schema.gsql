// TigerGraph GSQL Schema Definition for Fraud Investigation System
// IEEE-CIS Fraud Detection Edition (Hacker House Goa 2026)

CREATE GRAPH FraudGraph()

// ==========================================
// VERTEX DEFINITIONS
// ==========================================

CREATE VERTEX Customer (
    PRIMARY_ID customer_id STRING,
    customer_id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Card (
    PRIMARY_ID card_id STRING,
    card_id STRING,
    network STRING,
    card_type STRING,
    issuer_code INT
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Transaction (
    PRIMARY_ID txn_id STRING,
    txn_id STRING,
    ts DATETIME,
    amount DOUBLE,
    product_cd STRING,
    channel STRING,
    risk_score DOUBLE,
    addr1 STRING,
    addr2 STRING,
    p_emaildomain STRING,
    r_emaildomain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX DeviceProfile (
    PRIMARY_ID device_profile_id STRING,
    device_profile_id STRING,
    device_info STRING,
    os STRING,
    browser STRING,
    screen STRING,
    device_type STRING,
    is_proxy BOOL
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX EmailDomain (
    PRIMARY_ID domain STRING,
    domain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX BillingRegion (
    PRIMARY_ID region_code STRING,
    region_code STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX ClosedCase (
    PRIMARY_ID case_id STRING,
    case_id STRING,
    opened_at DATETIME,
    closed_at DATETIME,
    outcome STRING, // confirmed_fraud / cleared
    pattern STRING, // card_testing, card_not_present_fraud, etc.
    n_txns INT,
    exposure_usd DOUBLE,
    actions_taken STRING,
    report_filed BOOL,
    analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX InvestigationCase (
    PRIMARY_ID case_id STRING,
    case_id STRING,
    status STRING, // open, closed_fraud, closed_legitimate, escalated
    verdict STRING, // fraud, legitimate, uncertain
    fraud_probability DOUBLE,
    pattern STRING,
    exposure_usd DOUBLE,
    stop_reason STRING,
    summary STRING,
    created_at DATETIME
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// ==========================================
// EDGE DEFINITIONS
// ==========================================

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card);
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction);
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile);
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain);
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion);
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, interval_sec INT);

// Closed Case Historical Links
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction);
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card);
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card);

// In-Flight / Graph-Persisted Active Cases Links
CREATE DIRECTED EDGE CASE_INVOLVES (FROM InvestigationCase, TO Transaction);
CREATE DIRECTED EDGE CASE_ON_CARD (FROM InvestigationCase, TO Card);
CREATE DIRECTED EDGE CASE_CONNECTED_CARD (FROM InvestigationCase, TO Card);
CREATE DIRECTED EDGE CASE_CONNECTED_DEVICE (FROM InvestigationCase, TO DeviceProfile);
